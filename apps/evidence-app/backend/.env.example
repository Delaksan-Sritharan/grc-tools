# Backend environment variables
# Copy this file to .env and fill in your values.

# PostgreSQL connection string. Any Postgres works — Neon, Azure Database for
# PostgreSQL, or a local instance — just swap this URL; no code changes needed.
DATABASE_URL=postgresql://user:password@host:5432/compliance_db

# Asgardeo organization (tenant) name — used to build the UserInfo endpoint
# that validates every request's Bearer token.
ASGARDEO_ORG=your-asgardeo-org

# Client IDs of the two Asgardeo applications allowed to call this API. Both
# are accepted as a token audience; only the web app one can grant admin.
# Not secrets — in OAuth a client ID is public.
ASGARDEO_WEBAPP_CLIENT_ID=
ASGARDEO_RUNNER_CLIENT_ID=

# Asgardeo role names that grant each role here. Environment-specific, so
# staging and production will not use the same values.
ASGARDEO_ADMIN_ROLE=sre-compliance-evidence-admins-webapp-stg
ASGARDEO_ENGINEER_ROLE=sre-compliance-evidence-engineers-stg

# Azure Blob Storage for evidence files (required — there is no local fallback).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads

# Comma-separated CORS allow-list for the web frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: a schema for the app to create and own, instead of using the
# database's default "public" schema. Needed on a Postgres 15+ server where
# the app user does not have CREATE on "public" — Azure Database for
# PostgreSQL is the known case, since it hands "public" to its own admin
# role. Leave unset for Neon and local development; that keeps today's
# behaviour exactly, with tables in "public" and no schema created.
# Set it only on a database that is empty, or on one whose contents are
# expendable. Turning it on against a database that already holds the app's
# tables in "public" does not move them — Alembic finds no version table
# in the new schema, replays every migration into it, and leaves an empty
# application beside data it can no longer see. Nothing fails and nothing
# warns. Treat it as one way per database, and never change the name once
# it is set.
DB_SCHEMA=

# The Agent URL policy -- see app/agent_policy.py. Each Runner fetches it
# (GET /api/agent/policy) and enforces it in its browser, and new Agent Tasks
# are checked against it. All three are comma-separated and checked at startup.
#
# Approved portal domains (required -- there is no default, and the service
# won't start without it): example.com, or *.example.com for the domain and its
# subdomains. Include the sign-in pages each portal sends users through, e.g.
# *.azure.com,*.microsoftonline.com for the Azure Portal.
AGENT_ALLOWED_DOMAINS=
# Internal network: host names, single addresses, or ranges (CIDR, e.g.
# 10.20.0.0/16). A Runner's browser may reach private network addresses only
# through these: a listed host name may reach the private addresses it
# resolves to, and any connection may reach an address inside a listed range.
# Host names and single addresses are also approved as pages; a range is not,
# so a page opened by a raw address needs that address listed on its own.
# Loopback, link-local and cloud metadata addresses stay unreachable whatever
# is listed here.
AGENT_INTERNAL_HOSTS=
# Oldest Runner that may take tasks, e.g. 1.1.0. Leave empty until that
# version has been released, or every older Runner stops getting tasks.
AGENT_MIN_RUNNER_VERSION=
